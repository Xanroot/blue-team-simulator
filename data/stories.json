[
  {
    "id": 1,
    "title": "Phishing to PowerShell Attack",
    "description": "Malicious attachment leads to PowerShell execution and persistence.",
    "severity": "High",

    "timeline": [

      {
        "step": "User receives phishing email",
        "mitre": "T1566",
        "tactic": "Initial Access",

        "tactic_options": [
          "Initial Access",
          "Execution",
          "Persistence",
          "Discovery"
        ],

        "detection": "Email gateway alert",
        "alert": "Suspicious Email Attachment",
        "host": "USER-LAPTOP01",

        "process_tree": [
          "OUTLOOK.EXE",
          "WINWORD.EXE"
        ],

        "sysmon_log": {
          "event_id": "MDO Alert",
          "image": "WINWORD.EXE",
          "parent_image": "OUTLOOK.EXE",
          "command_line": "WINWORD.EXE invoice.docm"
        },

        "question": {
          "text": "What should the analyst do first?",
          "options": [
            "Isolate Host",
            "Ignore Alert",
            "Delete Logs"
          ],
          "correct_answer": "Isolate Host",
          "success_message": "Host isolated successfully.",
          "failure_message": "Threat spread across network."
        }
      },

      {
        "step": "Word document launches PowerShell",
        "mitre": "T1059.001",
        "tactic": "Execution",

        "tactic_options": [
          "Execution",
          "Persistence",
          "Discovery",
          "Impact"
        ],

        "detection": "Sysmon Event ID 1",
        "alert": "Suspicious PowerShell Execution",
        "host": "USER-LAPTOP01",

        "process_tree": [
          "WINWORD.EXE",
          "powershell.exe"
        ],

        "sysmon_log": {
          "event_id": "Sysmon Event ID 1",
          "image": "powershell.exe",
          "parent_image": "WINWORD.EXE",
          "command_line": "powershell.exe -enc SQBmACgA"
        },

        "question": {
          "text": "What is the best response?",
          "options": [
            "Block PowerShell",
            "Ignore Process",
            "Disable Defender"
          ],
          "correct_answer": "Block PowerShell",
          "success_message": "Malicious process terminated.",
          "failure_message": "Attacker gained persistence."
        }
      },

      {
        "step": "Registry persistence created",
        "mitre": "T1547",
        "tactic": "Persistence",

        "tactic_options": [
          "Persistence",
          "Discovery",
          "Reconnaissance",
          "Collection"
        ],

        "detection": "Registry modification alert",
        "alert": "Persistence Mechanism Detected",
        "host": "USER-LAPTOP01",

        "process_tree": [
          "powershell.exe",
          "reg.exe"
        ],

        "sysmon_log": {
          "event_id": "Sysmon Event ID 13",
          "image": "reg.exe",
          "parent_image": "powershell.exe",
          "command_line": "reg add HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run"
        },

        "question": {
          "text": "How should the analyst respond?",
          "options": [
            "Remove Persistence",
            "Ignore Registry Change",
            "Shutdown SIEM"
          ],
          "correct_answer": "Remove Persistence",
          "success_message": "Persistence removed successfully.",
          "failure_message": "Threat remained active."
        }
      }

    ]
  },

